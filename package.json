{
  "name": "pixora",
  "version": "1.5.0",
  "description": "浏览器与 Node 通用的图像能力内核：降采样阶梯、24 位 BMP 与索引色 PNG 编码、ZIP 打包与 CRC32、Real-ESRGAN 分块表、像素调整链与调色板量化。不碰 DOM，零依赖。",
  "keywords": [
    "image",
    "image-processing",
    "resize",
    "bmp",
    "png",
    "indexed-color",
    "palette",
    "quantize",
    "median-cut",
    "zip",
    "crc32",
    "super-resolution",
    "esrgan",
    "canvas",
    "dom-free"
  ],
  "license": "MIT",
  "author": "Pixora contributors",
  "homepage": "https://xuboboo.github.io/pixora/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuboboo/pixora.git"
  },
  "bugs": "https://github.com/xuboboo/pixora/issues",
  "main": "./assets/js/pixora-lib.js",
  "types": "./assets/js/pixora-lib.d.ts",
  "exports": {
    ".": {
      "types": "./assets/js/pixora-lib.d.ts",
      "import": "./assets/js/pixora-lib.mjs",
      "require": "./assets/js/pixora-lib.js",
      "default": "./assets/js/pixora-lib.js"
    },
    "./pixora-lib.js": "./assets/js/pixora-lib.js",
    "./pixora-lib.mjs": "./assets/js/pixora-lib.mjs",
    "./docs/api.md": "./docs/api.md",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/js/pixora-lib.js",
    "assets/js/pixora-lib.mjs",
    "assets/js/pixora-lib.d.ts",
    "docs/api.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/test-lib.mjs",
    "test:package": "node tools/test-package.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
